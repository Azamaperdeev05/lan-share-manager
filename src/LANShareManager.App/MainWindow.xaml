<Window x:Class="LANShareManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Share Manager — SMB ортақ папкаларды басқару" 
        Height="690" Width="1000"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Network info card -->
            <RowDefinition Height="Auto" />
            <!-- Action bar & shares title -->
            <RowDefinition Height="Auto" />
            <!-- Shares DataGrid/List -->
            <RowDefinition Height="*" />
            <!-- Selected share action buttons & status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtAppTitle" Text="LAN Share Manager" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="TxtAppSub" Text="Windows үшін SMB желілік ортақ папкаларын автоматтандырылған баптау" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Language Pills & Admin Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F1F5F9" CornerRadius="16" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnLangKk" Content="🇰🇿 KZ" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Margin="0,0,2,0" Click="BtnLangKk_Click" />
                        <Button x:Name="BtnLangRu" Content="🇷🇺 RU" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Margin="0,0,2,0" Click="BtnLangRu_Click" />
                        <Button x:Name="BtnLangEn" Content="🇬🇧 EN" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Click="BtnLangEn_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="AdminBadgeBorder" Background="{StaticResource SuccessBgBrush}" CornerRadius="6" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtAdminStatus" Text="✓ Әкімші құқығы: Қосулы" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Network Info Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtHostLabel" Text="Компьютер атауы:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtComputerName" Text="Загрузка..." FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TxtIpLabel" Text="Жергілікті IPv4 (LAN):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtLocalIp" Text="Определение..." FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TxtProfileLabel" Text="Желі профилі:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtNetworkProfile" Text="Определение..." FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSwitchPrivate" Content="Желіні Private қылу" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnSwitchPrivate_Click" />
                    <Button x:Name="BtnRefreshNetwork" Content="Жаңарту" Style="{StaticResource SecondaryButton}" Height="30" Click="BtnRefreshNetwork_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Shares Section Title & Create Button -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtSharesTitle" Text="Желілік ресурстар (SMB Shares):" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnConnectGuide" Content="🌐 Қалай қосылу керек? (Win+R)" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,10,0" Click="BtnConnectGuide_Click" />
                <CheckBox x:Name="ChkShowAdminShares" Content="Жүйеліктерді көрсету (C$, ADMIN$)" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkShowAdminShares_Changed" Unchecked="ChkShowAdminShares_Changed" />
                <Button x:Name="BtnCreateNewShare" Content="+ Жаңа ортақ папка құру" Style="{StaticResource PrimaryButton}" Height="36" Padding="18,0" Click="BtnCreateNewShare_Click" />
            </StackPanel>
        </Grid>

        <!-- 4. Shares Grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14">
            <DataGrid x:Name="GridShares" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EFEFEF"
                      RowHeight="38" Background="Transparent" BorderThickness="0"
                      SelectionChanged="GridShares_SelectionChanged"
                      MouseDoubleClick="GridShares_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColShareName" Header="Ресурс атауы" Binding="{Binding Name}" Width="170" FontWeight="SemiBold" />
                    <DataGridTextColumn x:Name="ColLocalPath" Header="Жергілікті жол" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn x:Name="ColAccess" Header="Қолжетімділік" Binding="{Binding DisplayAccess}" Width="160" />
                    <DataGridTextColumn x:Name="ColStatus" Header="Күйі" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Actions Bar & Status -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Actions for Selected Share -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnOpenFolder" Content="Папканы ашу" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="BtnOpenFolder_Click" />
                <Button x:Name="BtnCopyPath" Content="Жолды көшіру" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="BtnCopyPath_Click" />
                <Button x:Name="BtnShareInstructions" Content="Инструкция Win+R" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="BtnShareInstructions_Click" />
                <Button x:Name="BtnEditAccess" Content="Құқықты өзгерту" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="BtnEditAccess_Click" />
                <Button x:Name="BtnDiagnostics" Content="Диагностика" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="BtnDiagnostics_Click" />
                <Button x:Name="BtnRemoveShare" Content="Өшіру" Style="{StaticResource DangerButton}" Height="34" IsEnabled="False" Click="BtnRemoveShare_Click" />
            </StackPanel>

            <!-- Status Message -->
            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Дайын" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0" TextTrimming="CharacterEllipsis" />

            <!-- Utility Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnExport" Content="Экспорт..." Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" Click="BtnExport_Click" />
                <Button x:Name="BtnImport" Content="Импорт..." Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0" Click="BtnImport_Click" />
                <Button x:Name="BtnLogs" Content="Логтар" Style="{StaticResource SecondaryButton}" Height="34" Click="BtnOpenLogs_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
