<Window x:Class="LANShareManager.App.Views.CreateShareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать общий доступ к папке" 
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Создать общий сетевой ресурс (SMB)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Выберите локальную папку и настройте права доступа для устройств в локальной сети." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Main Form Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Folder Path -->
                    <TextBlock Text="Папка:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFolderPath" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtFolderPath_TextChanged" />
                        <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0" Click="BtnBrowse_Click" />
                    </Grid>
                    <TextBlock x:Name="TxtPathFeedback" FontSize="11" Margin="2,-4,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

                    <!-- Share Name -->
                    <TextBlock Text="Имя общего ресурса (Share name):" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtShareName" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" TextChanged="TxtShareName_TextChanged" />
                    <TextBlock x:Name="TxtShareFeedback" FontSize="11" Margin="2,-2,0,12" TextWrapping="Wrap" Visibility="Collapsed" />

                    <!-- Access Mode -->
                    <TextBlock Text="Уровень доступа для локальной сети:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Margin="0,0,0,16">
                        <RadioButton x:Name="RbReadOnly" Content="Только чтение (Read only) — пользователи сети могут просматривать и открывать файлы" Margin="0,4" />
                        <RadioButton x:Name="RbReadWrite" Content="Чтение и запись (Read and write) — разрешено изменять, создавать и удалять файлы" IsChecked="True" Margin="0,4" />
                        <RadioButton x:Name="RbFullControl" Content="Полный доступ (Full control) — полный контроль над файлами и каталогами" Margin="0,4" />
                    </StackPanel>

                    <!-- Options -->
                    <TextBlock Text="Параметры интеграции:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox x:Name="ChkFirewall" Content="Включить правила брандмауэра Windows для SMB (TCP 445)" IsChecked="True" Margin="0,4" />
                    <CheckBox x:Name="ChkSubfolders" Content="Применить разрешения NTFS к подпапкам и файлам (наследование)" IsChecked="True" Margin="0,4" />
                    <CheckBox x:Name="ChkTestAfterCreation" Content="Проверить доступность ресурса после создания (диагностика)" IsChecked="True" Margin="0,4" />

                    <!-- Pre-flight Validation Banner -->
                    <Border x:Name="BorderValidationSummary" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtValidationSummary" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" Height="34" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click" />
            <Button x:Name="BtnCreate" Content="Создать общий доступ" Style="{StaticResource PrimaryButton}" Width="180" Height="34" IsDefault="True" Click="BtnCreate_Click" />
        </StackPanel>
    </Grid>
</Window>
