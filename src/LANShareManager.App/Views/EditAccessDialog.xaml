<Window x:Class="LANShareManager.App.Views.EditAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение уровня доступа" 
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitle" Text="Настройка разрешений ресурса" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Выберите новый уровень доступа для сетевых пользователей." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Access Selection Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <RadioButton x:Name="RbReadOnly" Content="Только чтение (Read only)" Margin="0,6" />
                <TextBlock Text="Пользователи сети могут просматривать и читать файлы, но не могут сохранять изменения." Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,10" FontSize="11" />

                <RadioButton x:Name="RbReadWrite" Content="Чтение и запись (Read and write)" Margin="0,6" />
                <TextBlock Text="Пользователи сети могут открывать, редактировать, создавать и удалять файлы." Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,10" FontSize="11" />

                <RadioButton x:Name="RbFullControl" Content="Полный доступ (Full control)" Margin="0,6" />
                <TextBlock Text="Полный административный контроль над файлами и подкаталогами." Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,10" FontSize="11" />

                <CheckBox x:Name="ChkApplyNtfs" Content="Также синхронизировать права безопасности NTFS на диске" IsChecked="True" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True" Click="BtnCancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="110" Height="32" IsDefault="True" Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
