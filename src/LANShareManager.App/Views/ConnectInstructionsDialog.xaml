<Window x:Class="LANShareManager.App.Views.ConnectInstructionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Басқа компьютерден қосылу нұсқаулығы" 
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtHeaderTitle" Text="🌐 Басқа компьютерден қалай қосылу керек?" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="TxtHeaderSub" Text="Windows жүйесіндегі Win + R арқылы ортақ папкаға жылдам кіру" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Language Pills -->
            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="16" Padding="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnLangKk" Content="🇰🇿 KZ" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Click="BtnLangKk_Click" Margin="0,0,2,0" />
                    <Button x:Name="BtnLangRu" Content="🇷🇺 RU" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Click="BtnLangRu_Click" Margin="0,0,2,0" />
                    <Button x:Name="BtnLangEn" Content="🇬🇧 EN" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Click="BtnLangEn_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Guide Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <!-- Step 1 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                </Border>
                                <TextBlock x:Name="TxtStep1Title" Text="Win + R пернелерін басыңыз:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtStep1Desc" Text="Басқа компьютердің пернетақтасынан Win + R түймелерін қатар басыңыз. Экранның төменгі сол жағында «Выполнить / Run» терезесі ашылады." Foreground="{StaticResource TextSecondaryBrush}" Margin="28,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,8,0">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                </Border>
                                <TextBlock x:Name="TxtStep2Title" Text="Мына желілік жолды көшіріп қойыңыз (UNC Path):" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Primary IP Path -->
                            <TextBlock x:Name="TxtIpLabel" Text="IP мекенжай арқылы (Ұсынылады / Рекомендуется):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="28,0,0,2" />
                            <Grid Margin="28,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtIpPath" IsReadOnly="True" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Background="#FFFFFF" Padding="8,6" BorderBrush="{StaticResource CardBorderBrush}" />
                                <Button Grid.Column="1" Content="Көшіру (Копировать)" Style="{StaticResource PrimaryButton}" Height="34" Margin="6,0,0,0" Click="BtnCopyIp_Click" />
                            </Grid>

                            <!-- Hostname Path -->
                            <TextBlock x:Name="TxtHostLabel" Text="Компьютер атауы арқылы (Имя хоста):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="28,0,0,2" />
                            <Grid Margin="28,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtHostPath" IsReadOnly="True" Background="#FFFFFF" Padding="8,6" BorderBrush="{StaticResource CardBorderBrush}" />
                                <Button Grid.Column="1" Content="Көшіру" Style="{StaticResource SecondaryButton}" Height="34" Margin="6,0,0,0" Click="BtnCopyHost_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Width="20" Height="20" Margin="0,0,8,0">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                </Border>
                                <TextBlock x:Name="TxtStep3Title" Text="'Enter' немесе 'OK' басыңыз:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtStep3Desc" Text="Папка Проводникте бірден ашылады! Сіз файлдарды көріп, өзгертіп немесе жаңа файл сала аласыз." Foreground="{StaticResource TextSecondaryBrush}" Margin="28,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Password Tips & Permanent Drive Map -->
                    <Border Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="TxtCredTitle" Text="💡 Егер Windows құпиясөз (пароль) сұраса:" FontWeight="Bold" Foreground="#854D0E" Margin="0,0,0,2" />
                            <TextBlock x:Name="TxtCredDesc" Text="Осы компьютердің пайдаланушы атын (мысалы: .\Admin) және паролін енгізіп, «Запомнить учетные данные» белгішесін қойыңыз." Foreground="#713F12" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TextBlock x:Name="TxtNetUseTitle" Text="📌 Тұрақты желілік диск (Z:) қылып қосу пәрмені (CMD):" FontWeight="Bold" Foreground="#854D0E" Margin="0,0,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNetUseCmd" IsReadOnly="True" FontFamily="Consolas, monospace" FontSize="12" Background="#FFFFFF" Padding="6" BorderBrush="#FEF08A" />
                                <Button Grid.Column="1" Content="Көшіру" Style="{StaticResource SecondaryButton}" Height="30" Margin="6,0,0,0" Click="BtnCopyNetUse_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnClose" Content="Түсінікті, жабу" Style="{StaticResource PrimaryButton}" Width="150" Height="34" IsCancel="True" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
